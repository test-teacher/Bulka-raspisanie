[
  // =====================================================================
  //  ИСКЛЮЧЕНИЯ — дни, когда занятий нет
  //  (праздники, каникулы, отмена уроков, карантин).
  //
  //  Формат даты: "ГГГГ-ММ-ДД"  (год-месяц-день).
  //
  //  Можно писать двумя способами:
  //   1) просто дата строкой:            "2026-11-04",
  //   2) дата с названием (объектом):
  //      { "date": "2026-11-04", "title": "День народного единства" }
  //
  //  Название показывается на экране «Сегодня»/«Завтра».
  //  В эти дни расписание не считается «сегодняшним».
  //  Строки с // — комментарии, их можно оставлять и добавлять свои.
  // =====================================================================

  // --- Примеры (замените на свои даты) ---
  "2026-01-01",
  { "date": "2026-01-02", "title": "Новогодние каникулы" }

  // --- Новогодние каникулы ---
  // "2026-12-31",
  // { "date": "2027-01-01", "title": "Новый год" },

  // --- Праздники ---
  // { "date": "2026-11-04", "title": "День народного единства" },
  // { "date": "2027-02-23", "title": "День защитника Отечества" },
  // { "date": "2027-03-08", "title": "8 Марта" },
  // { "date": "2027-05-01", "title": "Праздник Весны и Труда" },
  // { "date": "2027-05-09", "title": "День Победы" },

  // --- Каникулы ---
  // { "date": "2026-10-26", "title": "Осенние каникулы" },
  // { "date": "2026-12-28", "title": "Зимние каникулы" },
  // { "date": "2027-03-22", "title": "Весенние каникулы" }
]
