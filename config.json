{
  // =====================================================================
  //  «РАСПИСАНИЕ ПРЕПОДАВАТЕЛЯ» — файл данных config.json
  //
  //  Как править:
  //   • Меняйте только текст между двойными кавычками:      "5А"
  //   • Строки, которые начинаются с //, — это комментарии,
  //     приложение их игнорирует, их можно оставлять и добавлять свои
  //   • Время — в 24-часовом формате:                        "08:40"
  //   • Запятая после последнего элемента не обязательна
  //   • Часовой пояс зафиксирован: Europe/Moscow
  //
  //  После правки сохраните файл и в приложении нажмите:
  //  «Настройки» → «Обновить данные».
  // =====================================================================

  "title": "Расписание преподавателя",
  "subtitle": "Русский язык и литература",
  "timezone": "Europe/Moscow",

  // ---------------------------------------------------------------------
  //  1. ЗВОНКИ
  //  Здесь только начало и конец урока. Перемены приложение считает само:
  //  от конца одного урока до начала следующего.
  // ---------------------------------------------------------------------
  "calls": [
    { "n": 1, "start": "08:40", "end": "09:20" },
    { "n": 2, "start": "09:30", "end": "10:10" },
    { "n": 3, "start": "10:20", "end": "11:00" },
    { "n": 4, "start": "11:20", "end": "12:00" }, // после 3-го урока большая перемена — 20 минут
    { "n": 5, "start": "12:10", "end": "12:50" },
    { "n": 6, "start": "13:00", "end": "13:40" },
    { "n": 7, "start": "13:50", "end": "14:30" }
  ],

  // ---------------------------------------------------------------------
  //  2. ДНИ НЕДЕЛИ
  //  Порядок колонок на экране «Неделя».
  //  "dayOff": true — день отмечается как выходной.
  // ---------------------------------------------------------------------
  "days": [
    { "key": "mon", "short": "Пн", "full": "Понедельник" },
    { "key": "tue", "short": "Вт", "full": "Вторник" },
    { "key": "wed", "short": "Ср", "full": "Среда" },
    { "key": "thu", "short": "Чт", "full": "Четверг" },
    { "key": "fri", "short": "Пт", "full": "Пятница", "dayOff": true },
    { "key": "sat", "short": "Сб", "full": "Суббота" },
    { "key": "sun", "short": "Вс", "full": "Воскресенье", "dayOff": true }
  ],
  // ---------------------------------------------------------------------
  //  3. РАСПИСАНИЕ УРОКОВ
  //  Ключи дней: mon — Пн, tue — Вт, wed — Ср, thu — Чт,
  //              fri — Пт, sat — Сб, sun — Вс.
  //  Внутри дня ключ — НОМЕР УРОКА (номер по звонкам из пункта 1).
  //  "type": "lesson" — обычный урок, "extra" — внеурочка.
  //  Если урока в этот день нет — просто не пишите эту строку.
  // ---------------------------------------------------------------------
  "schedule": {
    // Понедельник
    "mon": {
      "2": { "class": "5Б", "subject": "Русский язык", "type": "lesson" },
      "3": { "class": "5Б", "subject": "Литература",   "type": "lesson" },
      "4": { "class": "5А", "subject": "Русский язык", "type": "lesson" },
      "5": { "class": "9А", "subject": "Литература",   "type": "lesson" },
      "6": { "class": "5А", "subject": "Литература",   "type": "lesson" }
    },
    // Вторник
    "tue": {
      "1": { "class": "5Б", "subject": "Русский язык", "type": "lesson" },
      "2": { "class": "5Б", "subject": "Русский язык", "type": "lesson" },
      "3": { "class": "5А", "subject": "Русский язык", "type": "lesson" },
      "4": { "class": "5А", "subject": "Русский язык", "type": "lesson" }
    },
    // Среда
    "wed": {
      "2": { "class": "9А", "subject": "Литература", "type": "lesson" },
      "3": { "class": "5Б", "subject": "Литература", "type": "lesson" },
      "4": { "class": "5А", "subject": "Литература", "type": "lesson" }
    },
    // Четверг (3-го урока нет — получается «окно»)
    "thu": {
      "1": { "class": "5Б", "subject": "Русский язык", "type": "lesson" },
      "2": { "class": "5А", "subject": "Русский язык", "type": "lesson" },
      "4": { "class": "9А", "subject": "Литература",   "type": "lesson" },
      "5": { "class": "5Б", "subject": "Литература",   "type": "lesson" },
      "6": { "class": "5А", "subject": "Литература",   "type": "lesson" }
    },
    // Пятница — выходной
    "fri": {},
    // Суббота (4-й и 5-й уроки — внеурочка)
    "sat": {
      "1": { "class": "5Б", "subject": "Русский язык", "type": "lesson" },
      "2": { "class": "5А", "subject": "Русский язык", "type": "lesson" },
      "4": { "class": "5Б", "subject": "Внеурочка",    "type": "extra"  },
      "5": { "class": "5А", "subject": "Внеурочка",    "type": "extra"  }
    },
    // Воскресенье — выходной
    "sun": {}
  },

  // ---------------------------------------------------------------------
  //  4. РЕПЕТИТОРСТВО (отдельный блок)
  //  Показывается на экранах «Сегодня» и «Завтра»,
  //  а также отдельной строкой в «Неделе».
  //  День задаётся так же: mon, tue, wed, thu, fri, sat, sun.
  // ---------------------------------------------------------------------
  "tutoring": [
    { "name": "Артур", "day": "mon", "start": "18:00", "end": "19:00", "subject": "Русский язык" },
    { "name": "Артур", "day": "tue", "start": "18:00", "end": "19:00", "subject": "Математика" },
    { "name": "Артур", "day": "thu", "start": "18:00", "end": "19:00", "subject": "Математика" }
  ],

  // ---------------------------------------------------------------------
  //  5. ЦВЕТА И НАЗВАНИЯ
  //  Цвета классов — метка класса, цвета типов — полоска слева.
  //  Можно подставить любой цвет в формате #RRGGBB.
  // ---------------------------------------------------------------------
  "classColors": {
    "5А": "#3b82f6",
    "5Б": "#ef4444",
    "9А": "#10b981"
  },
  "typeColors": {
    "lesson": "#3b82f6",
    "extra": "#a855f7",
    "tutoring": "#f59e0b"
  },
  "typeNames": {
    "lesson": "Урок",
    "extra": "Внеурочка",
    "tutoring": "Репетиторство"
  },

  // Тексты сообщений (можно менять по своему вкусу)
  "texts": {
    // Сообщение, когда уроков нет на экране «Сегодня»
    "noLessons": "Сегодня занятий нет",
    // Сообщение, когда уроков нет на экране «Завтра»
    "noLessonsTomorrow": "Занятий нет",
    "holiday": "Выходной / праздник",
    "dayOff": "Выходной",
    "break": "Перемена",
    "window": "Окно",
    "tutoring": "Репетиторство"
  }
}
